<?xml version="1.0" encoding="UTF-8"?>
<!--
  Slippage repeat-run scheduler, 2026-08-29 -> 2026-09-03.

  This is deliberately a DUMB 5-minute poller. It knows nothing about the schedule.
  measure.mjs holds the slot table and decides, in UTC epoch milliseconds, whether anything is due;
  almost every invocation exits in a few milliseconds having found nothing.

  Why it is not a StartCalendarInterval any more: on 2026-08-29 the calendar version fired an hour
  EARLY. 16:00 local was requested and the job ran at 13:00 UTC, which is 15:00 CEST. launchd had
  applied standard time (CET, UTC+1) and ignored that the machine is on summer time (CEST, UTC+2).
  Moving the decision into the script in UTC removes launchd's timezone semantics from the problem
  entirely, and also gives a missed slot a 3-hour catch-up window instead of one fire-on-wake.

  Install:
    cp tools/slippage/com.trustrfq.slippage.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.trustrfq.slippage.plist

  Remove when the window closes (do this, or it polls forever):
    launchctl unload ~/Library/LaunchAgents/com.trustrfq.slippage.plist
    rm ~/Library/LaunchAgents/com.trustrfq.slippage.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trustrfq.slippage</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/acakbin1881/.local/bin/node</string>
    <string>/Users/acakbin1881/Projects/TrustRFQ/tools/slippage/measure.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/acakbin1881/Projects/TrustRFQ</string>

  <key>StandardOutPath</key>
  <string>/Users/acakbin1881/Projects/TrustRFQ/tools/slippage/runs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/acakbin1881/Projects/TrustRFQ/tools/slippage/runs/launchd.log</string>

  <!-- Poll every 5 minutes. A slot opens 2.5 min before its planned UTC time, so worst-case
       drift on a machine that is awake is under 5 minutes. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
