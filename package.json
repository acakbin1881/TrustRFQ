{
  "name": "trustrfq",
  "private": true,
  "type": "module",
  "description": "A signed-quote RFQ protocol for Stellar: Soroban settlement contracts, a stake-gated maker registry, a taker SDK and a reference desk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acakbin1881/TrustRFQ.git"
  },
  "homepage": "https://trustrfq.vercel.app",
  "keywords": ["stellar", "soroban", "rfq", "defi", "otc", "market-making"],
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desk",
    "build": "npm run build -w apps/desk",
    "preview": "npm run preview -w apps/desk",
    "typecheck": "tsc -p packages/sdk --noEmit && tsc -p apps/desk --noEmit",
    "test": "vitest run",
    "build:rfq-demo": "node tools/build-rfq-demo.mjs",
    "check:bundle": "node tools/checks/bundle-check-driver.mjs",
    "check:dev": "node tools/checks/dev-smoke.mjs",
    "capture": "node tools/checks/capture-server.mjs",
    "e2e:census": "node tools/e2e/run-all.mjs",
    "e2e:rfq": "node tools/e2e/run-all.mjs --lane rfq",
    "e2e:rfq:live": "node tools/e2e/rfq-driver.mjs"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.0.1",
    "playwright-core": "^1.60.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
