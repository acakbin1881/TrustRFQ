# Vercel builds the desk (npm run build -> apps/desk/dist). Exclude everything the
# build does not need so the upload stays small (the Rust build dir alone is
# ~400MB). NOTE: apps/desk/fixtures/ and packages/sdk must ship: the desk
# imports the SDK source and canonical.test.ts imports the fixture, and tsc
# runs as part of the build.
contracts/
target/
.claude/
.agents/
.planning/
.gsd/
skills-lock.json
*.log
apps/desk/dist/
apps/desk/dist-rfq/

# Dev-only: measurement tools, E2E drivers, vector-capture harness, vanilla
# reference implementation, design specs.
tools/
docs/

# Local tooling config, gitignored, listed here too so a CLI deploy from this
# directory never sees it either.
.mcp.json
