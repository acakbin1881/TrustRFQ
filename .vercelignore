# Vercel builds the frontend (npm run build → dist/). Exclude everything the
# build doesn't need so the upload stays small (the Rust build dir alone is
# ~400MB). NOTE: fixtures/ must ship — canonical.test.ts imports it and tsc
# runs as part of the build.
contracts/
target/
.claude/
.agents/
.planning/
.gsd/
skills-lock.json
*.log
dist/

# Dev-only: measurement tools, E2E drivers, vector-capture harness, vanilla
# reference implementation, design specs.
tools/
docs/

# Belt-and-braces: local tooling config, gitignored, so a Git-based deploy never
# sees it. A `vercel` CLI deploy from this directory is governed by THIS file
# rather than .gitignore, so it is listed here too.
.mcp.json
